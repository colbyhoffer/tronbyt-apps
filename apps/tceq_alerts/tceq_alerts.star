"""
TCEQ Refinery Alerts for Tronbyt/Tidbyt
=======================================

Watches the TCEQ Air Emission Event Report RSS feed
(https://www2.tceq.texas.gov/oce/eer/RSSDataFeed.xml) and shows the
events whose feed title contains a keyword (default "REFINERY").

The feed covers roughly the last seven days of events. The display
shows the newest matching event by start time. With "Rotate Through
All" on, each render shows the next match instead, so a Tronbyt cycling
through its apps walks the whole list.

The left 20px is an animated pixel-art refinery (flickering flare);
the right side shows, per event:
  - "TCEQ ALERT" header (underline shows position when rotating)
  - owner/operator name (regulated entity name from the feed title
    when details are off)
  - county + event start date/time (county from the detail page)
  - status + cause text (from the detail page)

Detail pages are fetched one per render and cached, so the extra
load on TCEQ is minimal. Turn "Fetch details" off to use the feed only.
"""

load("cache.star", "cache")
load("encoding/base64.star", "base64")
load("http.star", "http")
load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")

FEED_URL = "https://www2.tceq.texas.gov/oce/eer/RSSDataFeed.xml"
FEED_TTL = 900  # 15 min cache for the feed
DETAIL_TTL = 21600  # 6 h cache for event detail pages
ROTATE_KEY_TTL = 86400

DEFAULT_KEYWORD = "REFINERY"
DEFAULT_ACCENT = "#ffc400"  # amber, matches the sprite's yellow bands
TZ = "America/Chicago"  # TCEQ timestamps are Central time
SEP = " - "  # tom-thumb has no middle dot glyph

# 20x32 pixel refinery (blue outline, white towers, yellow bands, red tank
# stripe) with a three-frame flickering flare. Generated by sprite_gen.py
# in this folder; edit the grids there and paste the output here.
SPRITE_W = 20
SPRITE_FRAMES = [
    "",
    "",
    "",
]
FLAME_HOLD = 3  # root frames per flame frame
TEXT_X = SPRITE_W + 1
TEXT_W = 64 - TEXT_X
HEADER_FULL = "TCEQ ALERT"
HEADER_SHORT = "TCEQ"

MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]

DEMO_EVENTS = [
    {
        "id": "468365",
        "rn": "RN100214386",
        "name": "VALERO CORPUS CHRISTI REFINERY WEST PLANT",
        "operator": "VALERO REFINING-TEXAS LP",
        "link": "",
        "when": "NOV 11 11:45A",
        "ts": 0,
        "county": "NUECES",
        "status": "OPEN",
        "type": "EMISSIONS EVENT",
        "cause": "Upset conditions in Complex 1 required venting to a facility flare.",
    },
]

# ---------------------------------------------------------------------------
# Text helpers
# ---------------------------------------------------------------------------

def unescape(s):
    for a, b in [
        ("&amp;", "&"),
        ("&lt;", "<"),
        ("&gt;", ">"),
        ("&quot;", "\""),
        ("&#39;", "'"),
        ("&#x27;", "'"),
        ("&nbsp;", " "),
    ]:
        s = s.replace(a, b)
    return s

def strip_tags(s):
    out = ""
    rest = s
    for _ in range(200):
        i = rest.find("<")
        if i < 0:
            out += rest
            break
        out += rest[:i]
        j = rest.find(">", i)
        if j < 0:
            break
        rest = rest[j + 1:]
    return out

def squash(s):
    """Collapse all whitespace runs to single spaces."""
    return " ".join([w for w in s.replace("\n", " ").replace("\r", " ").replace("\t", " ").split(" ") if w])

def between(s, start, end, from_idx = 0):
    """Return (text between start and end after from_idx, index after end) or (None, -1)."""
    i = s.find(start, from_idx)
    if i < 0:
        return None, -1
    i += len(start)
    j = s.find(end, i)
    if j < 0:
        return None, -1
    return s[i:j], j + len(end)

def is_rn(tok):
    if len(tok) < 3 or not tok.startswith("RN"):
        return False
    return tok[2:].isdigit()

# ---------------------------------------------------------------------------
# Feed parsing
# ---------------------------------------------------------------------------

def parse_pubdate(s):
    """'Wed, 11 Nov 2026 15:55' -> (display string, unix seconds)."""
    s = squash(s)
    t = None
    for fmt in ["Mon, 02 Jan 2006 15:04", "Mon, 02 Jan 2006 15:04:05", "Mon, 02 Jan 2006"]:
        t = time.parse_time(s, format = fmt, location = TZ)
        if t != None:
            break
    if t == None:
        return s, 0
    label = "%s %d" % (MONTHS[t.month - 1], t.day)
    if t.hour != 0 or t.minute != 0:
        h = t.hour % 12
        if h == 0:
            h = 12
        mm = str(t.minute)
        if len(mm) < 2:
            mm = "0" + mm
        label += " %d:%s%s" % (h, mm, "P" if t.hour >= 12 else "A")
    return label, int(t.unix)

def parse_title(title):
    """'468365 - RN100214386 VALERO ... PLANT' -> (id, rn, name)."""
    title = squash(unescape(title))
    ev_id = ""
    rest = title
    sep = title.find(" - ")
    if sep >= 0 and title[:sep].isdigit():
        ev_id = title[:sep]
        rest = title[sep + 3:]
    rn = ""
    toks = rest.split(" ")
    if len(toks) > 1 and is_rn(toks[0]):
        rn = toks[0]
        rest = " ".join(toks[1:])
    return ev_id, rn, rest

def parse_feed(body):
    events = []
    pos = 0
    for _ in range(500):
        item, pos = between(body, "<item>", "</item>", pos)
        if item == None:
            break
        title, _ = between(item, "<title>", "</title>")
        link, _ = between(item, "<link>", "</link>")
        pub, _ = between(item, "<pubDate>", "</pubDate>")
        if title == None:
            continue
        ev_id, rn, name = parse_title(title)
        when, ts = parse_pubdate(pub or "")
        events.append({
            "id": ev_id,
            "rn": rn,
            "name": name,
            "title": squash(unescape(title)),
            "link": unescape(link or ""),
            "when": when,
            "ts": ts,
        })
    return events

def fetch_feed():
    res = http.get(FEED_URL, ttl_seconds = FEED_TTL, headers = {"User-Agent": "tronbyt-tceq-alerts"})
    if res.status_code != 200:
        return None, "HTTP %d" % res.status_code
    return parse_feed(res.body()), None

# ---------------------------------------------------------------------------
# Detail page (county, status, cause)
# ---------------------------------------------------------------------------

def field_after(html, label):
    """Text of the first <td> following a <th> containing `label`."""
    i = html.find(label)
    if i < 0:
        return ""
    cell, _ = between(html, "<td", "</td>", i)
    if cell == None:
        return ""
    gt = cell.find(">")
    if gt >= 0:
        cell = cell[gt + 1:]
    return squash(unescape(strip_tags(cell)))

def fetch_details(ev):
    if not ev.get("link"):
        return ev
    res = http.get(ev["link"], ttl_seconds = DETAIL_TTL, headers = {"User-Agent": "tronbyt-tceq-alerts"})
    if res.status_code != 200:
        return ev
    html = res.body()
    out = dict(ev)
    out["operator"] = field_after(html, "Name of Owner or Operator")
    out["county"] = field_after(html, "County:")
    out["status"] = field_after(html, "Incident Status:")
    out["type"] = field_after(html, "Event/Activity Type:")
    out["cause"] = field_after(html, "Cause of Emission Event")
    return out

# ---------------------------------------------------------------------------
# Selection: newest matching event first; optional rotation through all
# ---------------------------------------------------------------------------

def sort_key(ev):
    """Newest start time first; incident number breaks ties. The feed itself
    is ordered by incident number, which is not the same as start time."""
    ev_id = int(ev["id"]) if ev["id"].isdigit() else 0
    return (ev["ts"], ev_id)

def newest_first(events):
    return sorted(events, key = sort_key, reverse = True)

def pick_index(key, n):
    if n <= 1:
        return 0
    last = cache.get(key)
    if last == None or not last.isdigit():
        idx = int(time.now().unix / 20) % n
    else:
        idx = (int(last) + 1) % n
    cache.set(key, str(idx), ttl_seconds = ROTATE_KEY_TTL)
    return idx

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

def sprite():
    frames = []
    for b in SPRITE_FRAMES:
        img = render.Image(src = base64.decode(b))
        for _ in range(FLAME_HOLD):
            frames.append(img)
    return render.Animation(children = frames)

def pips(pos, total, accent):
    """1px underline that doubles as a position indicator: one segment per
    event, the current one lit. Falls back to a plain line when there are
    too many to fit."""
    if total < 2 or total > 10:
        return render.Box(width = TEXT_W, height = 1, color = "#2a3fbf")
    gap = 1
    seg = int((TEXT_W - gap * (total - 1)) / total)
    kids = []
    for i in range(total):
        if i > 0:
            kids.append(render.Box(width = gap, height = 1))
        kids.append(render.Box(width = seg, height = 1, color = accent if i == pos - 1 else "#2a3fbf"))
    return render.Row(children = kids)

def header_text():
    """tom-thumb is 4px per character (3px glyph + 1px gap)."""
    if len(HEADER_FULL) * 4 - 1 <= TEXT_W:
        return HEADER_FULL
    return HEADER_SHORT

def header(pos, total, accent):
    return render.Column(
        children = [
            render.Box(
                width = TEXT_W,
                height = 6,
                child = render.Row(
                    expanded = True,
                    main_align = "start",
                    cross_align = "end",
                    children = [render.Text(header_text(), font = "tom-thumb", color = accent)],
                ),
            ),
            pips(pos, total, accent),
        ],
    )

def marquee(text, font, color, delay, height):
    return render.Marquee(
        width = TEXT_W,
        height = height,
        scroll_direction = "horizontal",
        offset_start = 0,
        offset_end = TEXT_W,
        delay = delay,
        child = render.Text(text, font = font, color = color),
    )

def with_sprite(column):
    return render.Row(
        children = [
            sprite(),
            render.Padding(pad = (1, 0, 0, 0), child = column),
        ],
    )

def render_message(lines, accent):
    kids = [header(0, 0, accent), render.Box(width = TEXT_W, height = 2)]
    for ln in lines:
        kids.append(
            render.Padding(
                pad = (0, 1, 0, 0),
                child = render.Text(ln, font = "tom-thumb", color = "#aab"),
            ),
        )
    return render.Root(child = with_sprite(render.Column(children = kids)))

def render_event(ev, pos, total, accent, delay, show_details):
    # Owner/operator from the detail page when we have it, else the
    # regulated entity name from the feed title.
    name = ev.get("operator") or ev["name"] or ev.get("title", "?")

    meta_parts = []
    if show_details and ev.get("county"):
        meta_parts.append(ev["county"])
    if ev.get("when"):
        meta_parts.append(ev["when"])
    meta = SEP.join(meta_parts)

    detail_parts = []
    if show_details:
        if ev.get("status"):
            detail_parts.append(ev["status"])
        if ev.get("cause"):
            detail_parts.append(ev["cause"])
        elif ev.get("type"):
            detail_parts.append(ev["type"])
    if not detail_parts:
        detail_parts.append(ev.get("rn") or ("Event " + ev.get("id", "")))
    detail = SEP.join(detail_parts)

    status = ev.get("status", "")
    status_color = "#ff6b6b" if status == "OPEN" else "#9bd" if status else "#999"

    column = render.Column(
        children = [
            header(pos, total, accent),
            render.Box(width = TEXT_W, height = 1),
            render.Box(width = TEXT_W, height = 8, child = marquee(name, "tb-8", "#fff", delay, 8)),
            render.Box(width = TEXT_W, height = 1),
            render.Box(width = TEXT_W, height = 6, child = marquee(meta, "tom-thumb", accent, delay, 6)),
            render.Box(width = TEXT_W, height = 1),
            render.Box(width = TEXT_W, height = 6, child = marquee(detail, "tom-thumb", status_color, delay, 6)),
        ],
    )

    return render.Root(
        delay = delay,
        max_age = 120,
        child = with_sprite(column),
    )

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(config):
    keyword = squash(config.str("keyword", DEFAULT_KEYWORD)).upper() or DEFAULT_KEYWORD
    accent = config.str("accent", DEFAULT_ACCENT)
    delay = int(config.str("speed", "80"))
    max_days = int(config.str("max_days", "0"))
    show_details = config.bool("show_details", True)
    hide_empty = config.bool("hide_empty", True)
    rotate = config.bool("rotate", False)
    demo = config.bool("demo", False)

    if demo:
        return render_event(DEMO_EVENTS[0], 1, 1, accent, delay, show_details)

    events, err = fetch_feed()
    if err != None:
        return render_message(["TCEQ feed error", err], accent)

    cutoff = int(time.now().unix) - max_days * 86400 if max_days > 0 else 0
    matches = [
        ev
        for ev in events
        if keyword in ev["title"].upper() and (cutoff == 0 or ev["ts"] == 0 or ev["ts"] >= cutoff)
    ]

    if not matches:
        if hide_empty:
            return []
        age = "past %d day%s" % (max_days, "" if max_days == 1 else "s") if max_days > 0 else "in feed"
        return render_message(["No events", age], accent)

    matches = newest_first(matches)
    if rotate:
        idx = pick_index("tceq_alerts_idx_" + keyword + "_" + str(max_days), len(matches))
        pos, total = idx + 1, len(matches)
    else:
        idx, pos, total = 0, 1, 1  # latest only; no pips
    ev = matches[idx]
    if show_details:
        ev = fetch_details(ev)

    return render_event(ev, pos, total, accent, delay, show_details)

def get_schema():
    return schema.Schema(
        version = "1",
        fields = [
            schema.Text(
                id = "keyword",
                name = "Keyword",
                desc = "Only show events whose feed title contains this (case-insensitive)",
                icon = "filter",
                default = DEFAULT_KEYWORD,
            ),
            schema.Dropdown(
                id = "max_days",
                name = "Max Age",
                desc = "Ignore events that started more than this long ago",
                icon = "calendar",
                default = "0",
                options = [
                    schema.Option(display = "1 day", value = "1"),
                    schema.Option(display = "2 days", value = "2"),
                    schema.Option(display = "3 days", value = "3"),
                    schema.Option(display = "Whole feed (about 7 days)", value = "0"),
                ],
            ),
            schema.Toggle(
                id = "show_details",
                name = "Fetch Details",
                desc = "Load operator, county, status and cause from the event page",
                icon = "circleInfo",
                default = True,
            ),
            schema.Toggle(
                id = "rotate",
                name = "Rotate Through All",
                desc = "Off: always show the newest matching event. On: step through every match, one per render",
                icon = "rotate",
                default = False,
            ),
            schema.Toggle(
                id = "hide_empty",
                name = "Hide When Empty",
                desc = "Skip the app when there are no matching events",
                icon = "eyeSlash",
                default = True,
            ),
            schema.Dropdown(
                id = "speed",
                name = "Scroll Speed",
                desc = "Marquee scroll speed",
                icon = "gauge",
                default = "80",
                options = [
                    schema.Option(display = "Relaxed", value = "160"),
                    schema.Option(display = "Slow", value = "120"),
                    schema.Option(display = "Normal", value = "80"),
                    schema.Option(display = "Fast", value = "50"),
                ],
            ),
            schema.Color(
                id = "accent",
                name = "Accent Color",
                desc = "Keyword and county/date line color",
                icon = "brush",
                default = DEFAULT_ACCENT,
            ),
            schema.Toggle(
                id = "demo",
                name = "Demo Mode",
                desc = "Show a sample event instead of live data",
                icon = "flask",
                default = False,
            ),
        ],
    )
